# Copy this file to .env and fill in real values. Never commit .env.

# Azure Storage connection string (Azure Portal -> Storage Account -> Access keys,
# or `az storage account show-connection-string`).
AZURE_STORAGE_CONNECTION_STRING=<your-azure-storage-connection-string>

# Blob container that results are uploaded to. It must already exist - the scraper
# fails rather than creating it, so a typo here cannot strand uploads in a container
# nothing reads.
AZURE_CONTAINER_NAME=jobs-landing

# freehire.me personal API key. Optional: job search there is unauthenticated, so
# leaving this unset changes nothing about the results - a key only identifies the
# caller. Create one at https://freehire.me under API keys.
HIREME_API_KEY=<optional-freehire-personal-api-key>

# Comma-separated list of proxies, format user:pass@host:port (or host:port).
# Leave blank/unset to run without proxies. Not used for freehire, which is a
# public API with nothing to route around.
PROXIES=<proxy1-e.g.-user:pass@host:port>,<proxy2>
