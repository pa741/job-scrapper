# Copy this file to .env and fill in real values. Never commit .env.

# Azure Storage connection string (Azure Portal -> Storage Account -> Access keys,
# or `az storage account show-connection-string`).
AZURE_STORAGE_CONNECTION_STRING=<your-azure-storage-connection-string>

# Blob container that results are uploaded to (created automatically if missing).
AZURE_CONTAINER_NAME=jobs

# Comma-separated list of proxies, format user:pass@host:port (or host:port).
# Leave blank/unset to run without proxies.
PROXIES=<proxy1-e.g.-user:pass@host:port>,<proxy2>
